with open("message.txt", "r", encoding="utf-8") as f:
    lines = f.readlines()

binary = ""

for line in lines:
    stripped = line.rstrip("\n")
    
    # Extract trailing spaces/tabs manually
    trail = ""
    for ch in reversed(stripped):
        if ch in [" ", "\t"]:
            trail = ch + trail
        else:
            break

    for ch in trail:
        if ch == " ":
            binary += "0"
        elif ch == "\t":
            binary += "1"

print("Binary:", binary)












